# HackerRank Orchestrate — Environment Variables
# Copy this file to .env and fill in your API key:
#   cp .env.example .env

# ─── API Keys (set at least ONE) ───────────────────────────────
# The agent auto-detects which provider to use based on which key is set.
# Priority: ANTHROPIC > OPENROUTER > GROQ

# Option A: Anthropic directly
# ANTHROPIC_API_KEY=sk-ant-...

# Option B: OpenRouter (access Claude, GPT, Llama, etc.)
OPENROUTER_API_KEY=your_openrouter_key_here

# Option C: Groq (fast inference — Llama, Mixtral, Gemma)
GROQ_API_KEY=your_groq_key_here

# ─── Optional overrides ────────────────────────────────────────

# Force a specific provider (skip auto-detection):
# LLM_PROVIDER=openrouter

# Override the default model for your provider:
# LLM_MODEL_NAME=anthropic/claude-sonnet-4-20250514   # OpenRouter
# LLM_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct           # Groq
# LLM_MODEL_NAME=claude-sonnet-4-20250514             # Anthropic

# Number of corpus chunks to retrieve per ticket:
# TOP_K=6
